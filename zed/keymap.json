// Personal Cursor shortcuts. Standard behavior comes from base_keymap Cursor.
// Disable Cmd+K chords globally: Cmd+K switches tabs immediately, inline AI uses Cmd+Alt+K.
[
  {
    "use_key_equivalents": true,
    "bindings": {
      "cmd-k cmd-q": null,
      "cmd-k q": null,
      "cmd-k z": null,
      "cmd-k e": null,
      "cmd-k t": null,
      "cmd-k u": null,
      "cmd-k w": null,
      "cmd-k cmd-w": null,
      "cmd-k shift-enter": null,
      "cmd-k cmd-d": null,
      "cmd-k ctrl-cmd-d": null,
      "cmd-k cmd-i": null,
      "cmd-k cmd-b": null,
      "cmd-k cmd-/": null,
      "cmd-k cmd-h": null,
      "cmd-k cmd-l": null,
      "cmd-k cmd-[": null,
      "cmd-k cmd-]": null,
      "cmd-k cmd-1": null,
      "cmd-k cmd-2": null,
      "cmd-k cmd-3": null,
      "cmd-k cmd-4": null,
      "cmd-k cmd-5": null,
      "cmd-k cmd-6": null,
      "cmd-k cmd-7": null,
      "cmd-k cmd-8": null,
      "cmd-k cmd-9": null,
      "cmd-k cmd-0": null,
      "cmd-k cmd-j": null,
      "cmd-k r": null,
      "cmd-k p": null,
      "cmd-k v": null,
      "cmd-k s": null,
      "cmd-k cmd-p": null,
      "cmd-k cmd-s": null,
      "cmd-k cmd-t": null,
      "cmd-k cmd-shift-t": null,
      "cmd-k n": null,
      "cmd-k m": null,
      "cmd-k cmd-m": null,
      "cmd-k cmd-left": null,
      "cmd-k cmd-right": null,
      "cmd-k cmd-up": null,
      "cmd-k cmd-down": null,
      "cmd-k shift-left": null,
      "cmd-k shift-right": null,
      "cmd-k shift-up": null,
      "cmd-k shift-down": null,
      "cmd-k up": null,
      "cmd-k down": null,
      "cmd-k left": null,
      "cmd-k right": null,
      "cmd-k cmd-f": null,
      "cmd-k cmd-c": null,
      "cmd-k f12": null
    }
  },
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "pane::ActivatePreviousItem",
      "cmd-k": "pane::ActivateNextItem",
      "cmd-`": "terminal_panel::Toggle",
      "cmd-shift-m": "workspace::ToggleZoom",
      "cmd-alt-s": "workspace::ToggleRightDock",
      "cmd-b": "workspace::ToggleLeftDock",
      "cmd-shift-e": "project_panel::ToggleFocus",
      "ctrl-shift-g": "git_panel::ToggleFocus",
      "cmd-alt-m": "diagnostics::Deploy",
      "cmd-alt-k": "assistant::InlineAssist",
      "cmd-alt-,": "zed::OpenSettingsFile",
      "cmd-alt-;": "zed::OpenKeymap"
    }
  },
  {
    "context": "Pane",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "pane::ActivatePreviousItem",
      "cmd-k": "pane::ActivateNextItem",
      "cmd-ctrl-j": "pane::SwapItemLeft",
      "cmd-ctrl-k": "pane::SwapItemRight",
      "cmd-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ],
      "cmd-shift-t": "pane::ReopenClosedItem",
      "cmd-\\": "pane::SplitRight"
    }
  },
  {
    "context": "Editor && mode == full && !AgentPanel && !AcpThread && !InlineAssistant",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "pane::ActivatePreviousItem",
      "cmd-k": "pane::ActivateNextItem",
      "cmd-d": "editor::DuplicateLineDown",
      "cmd-shift-d": "editor::UniqueLinesCaseSensitive",
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "cmd-1": "editor::FoldAtLevel_1",
      "cmd-2": "editor::FoldAtLevel_2",
      "cmd-3": "editor::UnfoldAll",
      "cmd-shift-o": "editor::OrganizeImports",
      "cmd-l": "agent::AddSelectionToThread",
      "cmd-shift-l": "agent::AddSelectionToThread",
      "cmd-alt-k": "assistant::InlineAssist",
      "cmd-alt-d": "editor::SelectNext",
      "cmd-shift-k": "editor::DeleteLine",
      "alt-shift-f": "editor::Format",
      "cmd-/": "editor::ToggleComments",
      "cmd-alt-o": "outline::Toggle",
      "alt-shift-up": null,
      "alt-shift-down": null
    }
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "editor::ContextMenuNext",
      "cmd-k": "editor::ContextMenuPrevious",
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious"
    }
  },
  {
    "context": "Picker",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "menu::SelectNext",
      "cmd-k": "menu::SelectPrevious",
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious"
    }
  },
  {
    "context": "Picker > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "menu::SelectNext",
      "cmd-k": "menu::SelectPrevious"
    }
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-j": "workspace::ActivatePreviousPane",
      "cmd-k": "workspace::ActivateNextPane",
      "cmd-n": "workspace::NewTerminal",
      "cmd-d": "pane::SplitRight",
      "cmd-w": "pane::CloseActiveItem",
      "cmd-`": "terminal_panel::Toggle",
      "cmd-shift-m": "workspace::ToggleZoom",
      "cmd-alt-k": "assistant::InlineAssist",
      "cmd-alt-up": "workspace::ActivatePaneUp",
      "cmd-alt-down": "workspace::ActivatePaneDown",
      "cmd-alt-left": "workspace::ActivatePaneLeft",
      "cmd-alt-right": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "AgentPanel || (AcpThread > Editor) || (MessageEditor > Editor)",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-n": "agent::NewThread",
      "cmd-r": "agent::NewThread",
      "cmd-l": "workspace::ToggleRightDock",
      "cmd-shift-h": "agents_sidebar::ToggleThreadHistory"
    }
  }
]
