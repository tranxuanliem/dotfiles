// Zed settings - personal Cursor migration profile
// Documentation: https://zed.dev/docs/configuring-zed
// Open default settings with: zed: open default settings
{
    // === THEME ===
    "cli_default_open_behavior": "existing_window",
    "base_keymap": "Cursor",
    "icon_theme": "Material Icon Theme",
    "theme": "One Dark Pro Night Flat",

    // === TYPOGRAPHY ===
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_size": 15,
    "buffer_font_weight": 500,
    "buffer_line_height": {
        "custom": 1.6,
    },
    "buffer_font_features": {
        "calt": true,
        "liga": true,
    },

    // === UI FONT ===
    "ui_font_family": "JetBrainsMono Nerd Font Mono",
    "ui_font_size": 15,

    // === EDITOR BEHAVIOR ===
    "tab_size": 4,
    "hard_tabs": false,
    "soft_wrap": "editor_width",
    "preferred_line_length": 120,
    "show_wrap_guides": true,
    "wrap_guides": [120],

    // === CURSOR ===
    "cursor_blink": true,
    "cursor_shape": "bar",
    "current_line_highlight": "gutter",

    // === SCROLLING ===
    "vertical_scroll_margin": 3,
    "scroll_sensitivity": 1.0,

    // === SCROLLBAR ===
    "scrollbar": {
        "show": "auto",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_symbol": true,
        "diagnostics": "all",
    },

    // === GUTTER ===
    "gutter": {
        "line_numbers": true,
        "runnables": true,
        "breakpoints": true,
        "folds": true,
    },

    // === INDENT GUIDES ===
    "indent_guides": {
        "enabled": true,
        "line_width": 1,
        "active_line_width": 2,
        "coloring": "indent_aware",
        "background_coloring": "disabled",
    },

    // === COMPLETIONS ===
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "use_autoclose": true,
    "use_auto_surround": true,
    "always_treat_brackets_as_autoclosed": false,
    "multi_cursor_modifier": "cmd_or_ctrl",
    "show_whitespaces": "trailing",
    "sticky_scroll": { "enabled": true },

    // === INLAY HINTS ===
    "inlay_hints": {
        "enabled": false,
        "toggle_on_modifiers_press": { "control": true, "alt": true },
        "show_type_hints": true,
        "show_parameter_hints": false,
        "show_other_hints": true,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50,
    },

    // === FORMATTING ===
    "format_on_save": "on",
    "formatter": "auto",
    "prettier": {
        "options": { "singleQuote": true, "tabWidth": 4, "printWidth": 120 },
    },
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,

    // === FILE HANDLING ===
    "autosave": "off",
    "file_scan_exclusions": [
        "**/.git",
        "**/.DS_Store",
        "**/.cache",
        "**/node_modules",
        "**/vendor",
        "**/.next",
        "**/dist",
        "**/build",
        "**/__pycache__",
        "**/.venv",
        "**/target",
    ],

    // === FILE TYPE ASSOCIATIONS ===
    "file_types": {
        "JSONC": ["**/.zed/**/*.json", "**/zed/**/*.json", "**/.vscode/**/*.json"],
        "Shell Script": [".env.*"],
    },

    // === PROJECT PANEL ===
    "project_panel": {
        "button": true,
        "default_width": 260,
        "dock": "left",
        "file_icons": true,
        "folder_indicator": "both",
        "git_status": true,
        "indent_size": 16,
        "auto_reveal_entries": true,
        "auto_fold_dirs": false,
        "scrollbar": {
            "show": "auto",
        },
    },

    // === OUTLINE PANEL ===
    "outline_panel": {
        "button": true,
        "default_width": 260,
        "dock": "left",
        "file_icons": true,
        "folder_indicator": "both",
        "git_status": true,
        "indent_size": 16,
        "auto_reveal_entries": true,
        "auto_fold_dirs": true,
    },

    // === TABS ===
    "tabs": {
        "close_position": "right",
        "file_icons": true,
        "git_status": true,
        "activate_on_close": "history",
        "show_diagnostics": "errors",
    },
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": true,
    },
    "preview_tabs": {
        "enabled": true,
        "enable_preview_from_file_finder": false,
        "enable_preview_from_project_panel": true,
    },

    // === TERMINAL ===
    "terminal": {
        "shell": {
            "program": "zsh",
        },
        "dock": "bottom",
        "default_width": 640,
        "default_height": 320,
        "working_directory": "current_project_directory",
        "blinking": "on",
        "font_family": "JetBrainsMono Nerd Font",
        "font_size": 14,
        "line_height": {
            "custom": 1.4,
        },
        "toolbar": {
            "breadcrumbs": true,
        },
    },

    // === GIT ===
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
            "delay_ms": 600,
        },
    },
    "git_panel": {
        "dock": "left",
    },

    // === AI & EDIT PREDICTIONS ===
    // Zeta is Zed's open-source edit prediction model
    // Fine-tune edit predictions behavior
    "show_edit_predictions": true,
    "edit_predictions": {
        // Exclude sensitive files from predictions
        "provider": "zed",
        "disabled_globs": ["**/.env", "**/.env.*", "**/secrets.*", "**/*.pem", "**/*.key"],
    },

    // === AGENT PANEL (AI Assistant) ===
    "agent": {
        "default_profile": "write",
        "enabled": true,
        "button": true,
        "dock": "right",
        "default_width": 480,
        // Claude Opus 4.5 as default model
        "default_model": {
            "effort": "medium",
            "enable_thinking": true,
            "provider": "openai-subscribed",
            "model": "gpt-6-luna",
        },
        // Optional: Set different models for specific tasks
        // "inline_assistant_model": {
        //   "provider": "zed.dev",
        //   "model": "claude-sonnet-4"
        // },
        // "commit_message_model": {
        //   "provider": "zed.dev",
        //   "model": "gpt-5-nano"
        // },
        "expand_edit_card": true,
        "expand_terminal_card": true,
    },

    // === COLLABORATION PANEL ===
    "collaboration_panel": {
        "button": true,
        "dock": "left",
        "default_width": 260,
    },

    // === SEARCH ===
    "search": {
        "whole_word": false,
        "case_sensitive": false,
        "include_ignored": false,
        "regex": false,
    },

    // === LSP (Language Server) ===
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "checkOnSave": {
                    "command": "clippy",
                },
            },
        },
    },

    // === LANGUAGE-SPECIFIC SETTINGS ===
    "languages": {
        "JavaScript": {
            "tab_size": 4,
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "TypeScript": {
            "tab_size": 4,
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "TSX": {
            "tab_size": 4,
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "JSON": {
            "tab_size": 4,
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "JSONC": {
            "tab_size": 4,
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "SCSS": {
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "CSS": {
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "HTML": {
            "formatter": "prettier",
            "format_on_save": "on",
        },
        "Markdown": {
            "soft_wrap": "preferred_line_length",
            "preferred_line_length": 80,
            "format_on_save": "off",
            "show_edit_predictions": false,
        },
        "Python": {
            "tab_size": 4,
            "formatter": {
                "external": {
                    "command": "black",
                    "arguments": ["-"],
                },
            },
            "format_on_save": "on",
        },
        "Rust": {
            "tab_size": 4,
            "formatter": "language_server",
            "format_on_save": "on",
        },
        "YAML": {
            "tab_size": 4,
            "show_edit_predictions": false,
        },
    },

    // === VIM MODE (Uncomment to enable) ===
    // "vim_mode": true,
    // "vim": {
    //   "use_system_clipboard": "always",
    //   "use_multiline_find": true,
    //   "use_smartcase_find": true,
    //   "enable_vim_sneak": true
    // },

    // === TELEMETRY ===
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    // === WINDOW ===
    "confirm_quit": false,
    "restore_on_startup": "last_session",
    "restore_on_file_reopen": true,
    "centered_layout": {
        "left_padding": 0.15,
        "right_padding": 0.15,
    },

    // === TOOLBAR ===
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": true,
        "selections_menu": true,
    },

    // === AUTO-UPDATE ===
    "auto_update": true,

    // === AUTO-INSTALL EXTENSIONS (Optional) ===
    // Uncomment and customize based on your needs
    "auto_install_extensions": {
        "material-icon-theme": true,
        "python": true,
        "rust": true,
        "toml": true,
        "docker": true,
        "git-firefly": true,
    },
}
